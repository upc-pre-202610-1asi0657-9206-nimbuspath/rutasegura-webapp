# Development: Vite forwards REST and WebSocket requests to the same Gateway.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8000
# For AWS development, set the proxy target to the Gateway host (no service port).
# Production hosting must proxy /api and /hubs, or provide an HTTPS API base URL with allowed CORS.
# Never put Firebase service-account JSON, JWT signing keys or internal service tokens here.

# Optional only when hubs have a different public URL. Otherwise derives from API Gateway origin/prefix.
# VITE_TRACKING_HUB_URL=https://your-gateway.example/hubs/trip-tracking
